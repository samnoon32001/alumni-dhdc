datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  role            String   // 'super_admin' | 'teacher' | 'student'
  name            String
  email           String?
  phone           String?
  admissionNumber String?
  studentId       String?
  alumniId        String?
  status          String   @default("active") // 'active' | 'inactive'
  password        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([username])
  @@index([role])
}

model ClassRoom {
  id                  String    @id @default(cuid())
  name                String
  academicYear        String
  classTeacherId      String?
  status              String    @default("active")
  isAttendanceEnabled Boolean   @default(true)
  createdDate         DateTime  @default(now())

  students            Student[]
  subjects            Subject[]

  @@index([academicYear])
}

model Student {
  id                 String    @id @default(cuid())
  admissionNumber    String    @unique
  name               String
  classId            String
  class              ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  phone              String?
  email              String?
  username           String    @unique
  status             String    @default("active")
  createdDate        DateTime  @default(now())
  enrollmentDate     DateTime?
  photoUrl           String?
  dob                String?
  gender             String?
  bloodGroup         String?
  address            String?
  rollNumber         String?
  guardian           Json?
  classTeacherNotes  Json?
  electiveSubjectIds String[]  @default([])
  alumniId           String?
  isAlumni           Boolean   @default(false)

  marks              Mark[]
  achievements       Achievement[]
  behaviorRecords    BehaviorRecord[]
  leaveApplications  LeaveApplication[]
  attendanceRecords  AttendanceRecord[]
  attendanceClearances AttendanceClearance[]
  leaveClearanceApplications StudentLeaveClearanceApplication[]
  complaintsFeedback ComplaintFeedback[]

  @@index([classId])
  @@index([admissionNumber])
  @@index([username])
}

model Teacher {
  id                     String   @id @default(cuid())
  name                   String
  phone                  String?
  email                  String?
  username               String   @unique
  status                 String   @default("active")
  assignedSubjectIds     String[] @default([])
  assignedClassIds       String[] @default([])
  classTeacherOfClassIds String[] @default([])
  createdDate            DateTime @default(now())
  specialRoleTitle       String?
  canManageAllAttendance Boolean  @default(false)
  roleIds                String[] @default([])
  customPermissions      String[] @default([])
  deniedPermissions      String[] @default([])

  @@index([username])
}

model Subject {
  id                   String            @id @default(cuid())
  name                 String
  code                 String
  classId              String
  classIds             String[]          @default([])
  class                ClassRoom         @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedTeacherId    String?
  teacherId            String?
  status               String            @default("active")
  trackAttendance      Boolean           @default(true)
  isSplitSubject       Boolean           @default(false)
  splitGroupName       String?
  enrolledStudentIds   String[]          @default([])
  additionalTeacherIds String[]          @default([])

  evaluationLevels     EvaluationLevel[]
  marks                Mark[]
  attendanceRecords    AttendanceRecord[]

  @@index([classId])
}

model EvaluationLevel {
  id           String    @id @default(cuid())
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  maximumMark  Float
  displayOrder Int       @default(0)
  status       String    @default("active")

  marks        Mark[]

  @@index([subjectId])
}

model Mark {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId           String
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  evaluationLevelId String
  evaluationLevel   EvaluationLevel @relation(fields: [evaluationLevelId], references: [id], onDelete: Cascade)
  maximumMark       Float
  obtainedMark      Float?
  date              String
  enteredBy         String
  lastUpdated       DateTime        @default(now())
  academicYear      String?

  @@index([studentId])
  @@index([subjectId])
  @@index([evaluationLevelId])
}

model AcademicYear {
  id        String  @id @default(cuid())
  year      String  @unique
  isCurrent Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  role      String
  action    String
  entity    String
  entityId  String
  details   String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Achievement {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  category       String
  date           String
  description    String
  positionPrize  String?
  awardedBy      String?
  level          String?
  certificateUrl String?
  createdDate    DateTime @default(now())

  @@index([studentId])
}

model BehaviorRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           String
  title          String
  description    String
  severity       String?
  actionTaken    String?
  points         Int?
  followUpStatus String?
  recordedBy     String
  recordedById   String?
  recordedByName String?
  recordedByRole String
  date           String

  @@index([studentId])
}

model ActiveHourSlot {
  id              String  @id @default(cuid())
  label           String
  startTime       String
  endTime         String
  durationMinutes Int
  isActive        Boolean @default(true)
}

model LeaveApplication {
  id                     String    @id @default(cuid())
  studentId              String
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentAdmissionNumber String
  studentName            String
  classId                String
  academicYear           String?
  leaveType              String
  startDate              String
  endDate                String
  startTime              String?
  endTime                String?
  slotsIncluded          String[]  @default([])
  totalDurationMinutes   Int
  totalDurationFormatted String
  reason                 String
  status                 String    @default("pending")
  appliedAt              DateTime  @default(now())
  reviewedBy             String?
  reviewedByName         String?
  reviewedAt             DateTime?
  hasArrived             Boolean   @default(false)
  arrivedAt              DateTime?
  remarks                String?

  @@index([studentId])
  @@index([status])
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  date           String
  academicYear   String?
  classId        String
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period         Int
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         String
  lateArrivalTime String?
  lateReason     String?
  markedBy       String
  markedAt       DateTime @default(now())
  remarks        String?

  @@index([date, classId, subjectId, period])
  @@index([studentId, date])
}

model AttendanceClearance {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId          String?
  grantedBy          String
  grantedByName      String
  grantedByRole      String
  approvedPercentage Float?
  reason             String
  clearedDate        DateTime @default(now())
  academicYear       String
  notes              String?

  @@index([studentId])
}

model StudentLeaveClearanceApplication {
  id                     String    @id @default(cuid())
  studentId              String
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName            String
  studentAdmissionNumber String
  classId                String
  className              String
  academicYear           String?
  subjectId              String
  subjectName            String
  recordIds              String[]  @default([])
  dates                  String[]  @default([])
  periods                Int[]     @default([])
  clearanceType          String
  reason                 String
  status                 String    @default("pending")
  appliedAt              DateTime  @default(now())
  reviewedBy             String?
  reviewedByName         String?
  reviewedByRole         String?
  reviewedAt             DateTime?
  reviewRemarks          String?

  @@index([studentId])
  @@index([status])
}

model ComplaintFeedback {
  id                     String    @id @default(cuid())
  studentId              String
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentAdmissionNumber String
  studentName            String
  classId                String
  receiverType           String
  title                  String
  category               String
  message                String
  status                 String    @default("pending")
  response               String?
  respondedBy            String?
  respondedByName        String?
  respondedAt            DateTime?
  submittedAt            DateTime  @default(now())
  isAnonymous            Boolean   @default(false)

  @@index([studentId])
  @@index([status])
  @@index([receiverType])
}

model AttendanceRulesConfig {
  id                               String   @id @default("default")
  maxOfficialLeavePercent          Float    @default(10)
  maxCasualLeavePercent            Float    @default(15)
  maxTotalLeavesPercent            Float    @default(25)
  maxOfficialCasualCombinedPercent Float    @default(15)
  minRequiredAttendancePercent     Float    @default(85)
  academicLeaveCountedAsPresent    Boolean  @default(true)
  clearanceAllowedRoles            String[] @default([])
  clearanceTeacherIds              String[] @default([])
  customRoleRules                  Json?
}

model TimetablePeriodDefinition {
  id           String  @id @default(cuid())
  periodNumber Int
  name         String
  startTime    String
  endTime      String
  isBreak      Boolean @default(false)
  breakLabel   String?
}

model TimetableSlot {
  id           String  @id @default(cuid())
  dayOfWeek    String
  periodNumber Int
  classId      String
  subjectId    String
  teacherId    String?
  room         String?
  isSplitSlot  Boolean @default(false)

  @@index([classId, dayOfWeek])
}

model RoleDefinition {
  id          String   @id
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
}

model ShowcaseCard {
  id                     String   @id @default(cuid())
  title                  String
  subtitle               String?
  studentName            String
  studentAdmissionNumber String?
  studentId              String?
  percentage             String
  scoreDetails           String?
  sectionOrClass         String
  classId                String?
  category               String
  priority               Int      @default(1)
  badgeText              String?
  imageUrl               String?
  description            String?
  accentGradient         String   @default("gold")
  targetAudience         String   @default("all")
  targetRoles            String[] @default([])
  targetClassIds         String[] @default([])
  targetStudentIds       String[] @default([])
  order                  Int      @default(0)
  isActive               Boolean  @default(true)
  examName               String?
  academicYear           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String?
  createdByName          String?
}

model StudentAccountTransaction {
  id                     String   @id @default(cuid())
  studentId              String
  studentAdmissionNumber String?
  studentName            String?
  classId                String?
  type                   String   // 'income' | 'expense'
  category               String   // e.g. "Stationery", "Books", "Pocket Money", "Mess", "Fee"
  amount                 Float
  date                   DateTime @default(now())
  description            String?
  paymentMode            String?  @default("cash") // 'cash' | 'upi' | 'bank_transfer' | 'online' | 'other'
  receiptNumber          String?
  recordedBy             String?  // User ID
  recordedByName         String?
  recordedByRole         String?
  academicYear           String?
  status                 String?  @default("confirmed") // 'draft' | 'confirmed'
  confirmedBy            String?
  confirmedByName        String?
  confirmedAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([academicYear])
  @@index([date])
}

model StudentAccountCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   @default("both") // 'income' | 'expense' | 'both'
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SystemLockSettings {
  id                  String  @id @default("default")
  isLevelAddingLocked Boolean @default(false)
  isMarkEntryLocked   Boolean @default(false)
}

model InstitutionSettings {
  id                String   @id @default("default")
  name              String   @default("DARUL HIDAYA DA'WA COLLEGE, MANOOR")
  shortName         String   @default("DHDC Portal")
  subtitle          String?  @default("Continuous & Comprehensive Evaluation System")
  address           String?  @default("Manoor, P.O. Edappal, Malappuram Dt., Kerala 679578")
  logoUrl           String?
  faviconUrl        String?
  appIconUrl        String?
  phone             String?  @default("+91 494 268 0000")
  email             String?  @default("dhdcmanoor@gmail.com")
  website           String?  @default("https://dhdc.in")
  affiliationNumber String?  @default("DHDC-EDU-MANOOR")
  establishedYear   String?  @default("1998")
  reportCardHeader  String?  @default("DARUL HIDAYA DA'WA COLLEGE, MANOOR")
  reportCardFooter  String?  @default("Continuous & Comprehensive Evaluation (CCE) Student Report Card")
  updatedAt         DateTime @default(now()) @updatedAt
}

model ReadingProgramSettings {
  id                       String   @id @default("default")
  isEnabledForAll          Boolean  @default(false)
  allowedClassIds          String[] @default([])
  allowedStudentIds        String[] @default([])
  title                    String   @default("Library & Student Reading Track")
  description              String?  @default("Continuous reading tracking, activity journal, and evaluation")
  defaultPointsPerActivity Float    @default(5.0)
  defaultPointsPerBook     Float    @default(20.0)
  updatedAt                DateTime @default(now()) @updatedAt
  updatedBy                String?
}

model ReadingBook {
  id                     String            @id @default(cuid())
  studentId              String
  studentName            String
  studentAdmissionNumber String
  classId                String
  title                  String
  author                 String
  category               String            @default("General")
  source                 String            @default("library")
  totalPages             Int               @default(100)
  currentPage            Int               @default(0)
  status                 String            @default("reading")
  startDate              String
  completedDate          String?
  coverUrl               String?
  description            String?
  totalPoints            Float             @default(0)
  teacherRemarks         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  activities             ReadingActivity[]

  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model ReadingActivity {
  id                     String      @id @default(cuid())
  bookId                 String
  book                   ReadingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookTitle              String
  studentId              String
  studentName            String
  studentAdmissionNumber String
  classId                String
  title                  String
  startPage              Int?
  endPage                Int?
  pagesRead              Int         @default(0)
  date                   String
  durationMinutes        Int?
  summaryPoints          String
  status                 String      @default("submitted")
  score                  Float?
  maxScore               Float?      @default(10)
  teacherFeedback        String?
  reviewedBy             String?
  reviewedByName         String?
  reviewedAt             DateTime?
  taskId                 String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([bookId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@index([date])
}

model ReadingTask {
  id               String   @id @default(cuid())
  title            String
  description      String
  targetType       String   @default("all_allowed")
  targetClassIds   String[] @default([])
  targetStudentIds String[] @default([])
  bookTitle        String?
  bookAuthor       String?
  attachmentUrl    String?
  attachmentName   String?
  attachmentType   String?
  externalLink     String?
  targetPages      String?
  pointsReward     Float?   @default(10)
  dueDate          String?
  status           String   @default("active")
  createdBy        String
  createdByName    String
  createdByRole    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdBy])
}

// =========================================================================
// ALUMNI PORTAL MODELS
// =========================================================================

model AlumniZone {
  id          String   @id @default(cuid())
  name        String   @unique
  region      String   @default("Kerala") // "Kerala", "India", "International"
  description String?
  isActive    Boolean  @default(true)
  alumni      Alumni[]
}

model Alumni {
  id                     String             @id @default(cuid())
  admissionNumber        String             @unique
  name                   String
  gender                 String?
  dob                    String?
  bloodGroup             String?
  photoUrl               String?
  
  // Contact & Social
  email                  String?
  phone                  String?
  whatsappNumber         String?
  
  // Mandatory Zone & Geography
  zoneId                 String?
  zone                   AlumniZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneName               String?
  
  // Addresses
  permanentAddress       String?
  currentCity            String?
  currentState           String?            @default("Kerala")
  currentCountry         String?            @default("India")
  postalCode             String?

  // Academic & Batch Details
  admissionYear          String?
  passoutBatchYear       String             // e.g. "2024", "2025"
  completedClass         String             @default("10th Standard")
  finalGradeOrPercentage String?
  
  // Current Professional / Higher Education
  currentStatus          String?            @default("Higher Studies") // "Higher Studies", "Employed", "Business", "Research"
  currentInstitution     String?
  courseOrDegree         String?
  designation            String?
  organizationOrCompany  String?
  
  // Onboarding & Profile Completion Flag
  isProfileCompleted     Boolean            @default(false)
  completedSteps         Int                @default(0)
  
  // Privacy & Directory Settings
  isPublicProfile        Boolean            @default(true)
  showContactNumber      Boolean            @default(false)
  showEmail              Boolean            @default(true)
  willingToMentor        Boolean            @default(false)
  
  // Relational link to Student & User
  studentId              String?            @unique
  userId                 String?            @unique
  verificationStatus     String             @default("VERIFIED") // "VERIFIED", "PENDING", "REJECTED"
  bio                    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  donations              AlumniDonation[]
  readNotificationIds    String[]           @default([])

  @@index([zoneId])
  @@index([passoutBatchYear])
  @@index([admissionNumber])
  @@index([isProfileCompleted])
}

model AlumniAnnouncement {
  id            String    @id @default(cuid())
  title         String
  content       String
  category      String    @default("General") // "General", "Event", "Reunion", "Donation Drive", "Urgent"
  targetZoneId  String?
  targetBatch   String?
  priority      String    @default("normal")  // "normal", "high", "urgent"
  attachmentUrl String?
  bannerUrl     String?
  isPinned      Boolean   @default(false)
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?
  createdBy     String?
  createdByName String?

  @@index([publishedAt])
  @@index([targetZoneId])
  @@index([category])
}

model AlumniDonationCycle {
  id            String           @id @default(cuid())
  academicYear  String           // e.g. "2025-2026"
  cycle         String           // "H1_JAN_JUN" or "H2_JUL_DEC"
  label         String           // "2025-2026 Term 1 (H1)" or "2025-2026 Term 2 (H2)"
  startDate     DateTime
  endDate       DateTime
  defaultTarget Float            @default(3000.0)
  isCurrent     Boolean          @default(false)
  description   String?
  createdAt     DateTime         @default(now())

  donations     AlumniDonation[]

  @@unique([academicYear, cycle])
}

model AlumniDonation {
  id              String              @id @default(cuid())
  alumniId        String
  alumni          Alumni              @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  admissionNumber String
  alumniName      String
  cycleId         String
  cycle           AlumniDonationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  targetAmount    Float               @default(3000.0)
  paidAmount      Float               @default(0.0)
  balanceAmount   Float               @default(0.0)
  status          String              @default("PENDING") // "PENDING", "PARTIAL", "COMPLETED", "OVERDUE"
  
  lastPaymentDate DateTime?
  paymentMethod   String?
  transactionRef  String?
  receiptNumber   String?             @unique
  receiptUrl      String?
  notes           String?
  recordedBy      String?
  recordedByName  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  payments        AlumniPaymentRecord[]

  @@index([alumniId])
  @@index([cycleId])
  @@index([status])
  @@index([admissionNumber])
}

model AlumniPaymentRecord {
  id             String         @id @default(cuid())
  donationId     String
  donation       AlumniDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  amount         Float
  paymentDate    DateTime       @default(now())
  paymentMethod  String         @default("UPI")
  transactionRef String?
  receiptNumber  String?
  notes          String?
  recordedByName String?
  createdAt      DateTime       @default(now())

  @@index([donationId])
}




